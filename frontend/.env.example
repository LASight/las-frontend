VITE_API_BASE_URL=http://127.0.0.1:8000

# Run the digitization workspace against an in-browser stand-in instead of the
# API. The whole six-step wizard becomes clickable with no backend, no torch
# install and no model checkpoint - useful for building the review canvas and
# for demoing offline.
#
# Curves produced this way are generated in the browser. They are not
# digitization results, and the UI says so on every step.
VITE_DIGITIZATION_MOCK=false
